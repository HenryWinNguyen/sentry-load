{
  "title": "Sentry Load — fleet health",
  "uid": "sentry-load-fleet",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Live workers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sentry_coordinator_live_workers", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Jobs in progress",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sentry_worker_jobs_in_progress", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Test submissions by outcome (5m rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (result) (rate(sentry_coordinator_tests_created_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Coordinator request rate by route (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (route) (rate(sentry_coordinator_http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Coordinator 5xx rate (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(sentry_coordinator_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Coordinator p95 latency by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(sentry_coordinator_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Load requests generated (5m rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(sentry_worker_requests_generated_total[5m])",
          "legendFormat": "requests/s",
          "refId": "A"
        },
        {
          "expr": "rate(sentry_worker_request_errors_total[5m])",
          "legendFormat": "errors/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Jobs finished by outcome (5m rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum by (circuit_broken) (rate(sentry_worker_jobs_total[5m]))",
          "legendFormat": "circuit_broken={{circuit_broken}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Goroutines (coordinator vs worker)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "go_goroutines{job=\"sentry-load-coordinator\"}",
          "legendFormat": "coordinator",
          "refId": "A"
        },
        {
          "expr": "go_goroutines{job=\"sentry-load-worker\"}",
          "legendFormat": "worker",
          "refId": "B"
        }
      ]
    }
  ]
}
